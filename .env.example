# Base de données PostgreSQL
DB_USER=forfaitflow
DB_PASSWORD=changeme_use_a_strong_password_here
DB_NAME=forfaitflow

# Sécurité JWT (générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET=changeme_generate_a_random_secret_key_of_at_least_64_chars

# Compte administrateur créé au premier démarrage
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme_your_secure_password

# Documentation interactive (/docs, /redoc) : fermée par défaut, à n'activer qu'en développement
# ENVIRONMENT=development

# Fuseau horaire (laisser Europe/Paris)
TZ=Europe/Paris
